# ==============================================================================
# VARIABLES DE ENTORNO - SUPABASE (OPCIONALES PARA MODO NUBE MULTIUSUARIO)
# La autenticación y el cambio permanente de claves requieren Supabase en producción.
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica-de-supabase

# Obligatoria en el servidor para operar las cuentas protegidas.
# Nunca exponer esta variable con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada
